{
  "name": "smart-tha-pho",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pet Registration Management System for เทศบาลท่าโพธ์",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:platform",
    "dev:api": "npm run dev --workspace @smart-thapho/api",
    "dev:platform": "npm run dev --workspace @smart-thapho/platform",
    "dev:admin": "npm run dev:platform",
    "build": "npm run build --workspace @smart-thapho/shared && npm run build --workspace @smart-thapho/platform",
    "test": "npm run test --workspace @smart-thapho/api && npm run test --workspace @smart-thapho/shared",
    "create-admin": "node scripts/admin/create-admin.js",
    "start": "powershell -ExecutionPolicy Bypass -File ./start-smart-tha-pho.ps1",
    "line:audit": "node scripts/line/audit-rich-menu-v12.mjs",
    "line:sync": "powershell -ExecutionPolicy Bypass -File scripts/line/setup-line-rich-menus.ps1",
    "line:webhook:test": "powershell -ExecutionPolicy Bypass -File scripts/line/test-line-webhook.ps1",
    "maintenance:maps": "node scripts/maintenance/remove-generated-map-coordinates.mjs"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
