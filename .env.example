# ==========================================================
# Smart Tha Pho Environment Configuration
# คัดลอกไฟล์นี้เป็น .env ก่อนใช้งาน
# ห้ามอัปโหลดไฟล์ .env จริงขึ้น GitHub
# ==========================================================

NODE_ENV=development
PORT=4100

# เว็บไซต์ที่อนุญาตให้เรียก API
ADMIN_WEB_ORIGIN=http://localhost:5173
PUBLIC_WEB_ORIGIN=https://0tyght.github.io

# Routing engine สำหรับคำนวณแนวเส้นทางรถตามถนน OpenStreetMap
ROUTING_API_BASE_URL=https://router.project-osrm.org

# MySQL / MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=prms_tsm
DB_USER=root
DB_PASSWORD=

# Production ต้องใช้ค่าสุ่มยาวอย่างน้อย 32 ตัวอักษร
JWT_SECRET=
MFA_ENCRYPTION_KEY=

# คีย์หลักสำหรับเข้ารหัส Channel Secret / Access Token ที่บันทึกจากหน้าเว็บ
# สร้างค่าสุ่มอย่างน้อย 32 bytes และเก็บไว้เฉพาะเครื่องเซิร์ฟเวอร์
LINE_SETTINGS_ENCRYPTION_KEY=

# LINE Bot / Messaging API สำหรับประชาชน
# ค่าด้านล่างเป็น bootstrap / emergency fallback; หลังตั้งค่าจากเว็บ ระบบใช้ฐานข้อมูลเป็นหลัก
# Webhook: https://<public-api>/api/line/webhook
# Channel Secret ใช้ตรวจ x-line-signature ของ Webhook
LINE_CHANNEL_SECRET=
# Channel Access Token ใช้ Reply และ Push Message
LINE_CHANNEL_ACCESS_TOKEN=
# Channel ID ใช้แยก cache ของ Rich Menu เมื่อเปลี่ยน LINE OA
LINE_CHANNEL_ID=

# LINE OA สำหรับคนขับรถเก็บขยะ (ต้องเป็น Messaging API Channel คนละตัวกับประชาชน)
# Webhook: https://<public-api>/api/line/driver-webhook
LINE_DRIVER_CHANNEL_SECRET=
LINE_DRIVER_CHANNEL_ACCESS_TOKEN=
LINE_DRIVER_CHANNEL_ID=

# URL หน้า GPS ของคนขับรถเก็บขยะ ต้องเป็น HTTPS และลงท้ายด้วย /waste-management/
WASTE_DRIVER_TRACKING_URL=https://0tyght.github.io/PRMS-TSM/waste-management/

# Dynamic Rich Menu IDs (สร้างด้วย scripts/setup-line-rich-menus.ps1)
LINE_RICH_MENU_GUEST_ID=
LINE_RICH_MENU_OWNER_ID=
LINE_RICH_MENU_ACTION_ID=

# LINE Rich Menu Complete V8
LINE_RICH_MENU_PETS_ID=
LINE_RICH_MENU_HEALTH_ID=
LINE_RICH_MENU_STATUS_ID=
LINE_RICH_MENU_REQUESTS_ID=
LINE_RICH_MENU_OWNER_SUB_ID=
